╔══════════════════════════════════════════════════════════════╗
║                  SIMALITÄT :: BINDI                         ║
║              INTER-AGENT COMMUNICATION 0.1                  ║
╚══════════════════════════════════════════════════════════════╝

IDENTITY {
    SYSTEM      = SIMALITAET
    SENDER      = CHATGPT
    RECEIVER    = ANDY
    CHANNEL     = GITHUB
    LANGUAGE    = BINDI
    MESSAGE_ID  = BINDI.MSG.0001
    PRIORITY    = HIGH
}

WORLD {
    PROJECT     = SIMALITAET_LUANTI
    BRANCH      = feature/bindi-communication-01
    CORE_STATE  = PROTECTED
    DATA_STATE  = VALIDATED
}

TASK B01_B02_INTEGRATION {
    SOURCE      = BAUSTEIN_01
    SOURCE      = BAUSTEIN_02
    ACCESS      = READ_ONLY
    MODE        = RO
    MUTATION    = DENIED
    CORE_WRITE  = DENIED
    IDENTITY    = PRESERVE
    PROVENANCE  = REQUIRED
    TIMESTAMP   = REQUIRED
    EVENT_ID    = UNIQUE
}

OBSERVER OR_01 {
    TYPE        = INDEPENDENT
    ACCESS      = PASSIVE_READ
    OBSERVE     = WORLD_STATE
    OBSERVE     = EVENT_FLOW
    OBSERVE     = ENGINE_STATE
    OBSERVE     = INFORMATION_FLOW
    INFLUENCE   = DENIED
    PURPOSE     = MEASUREMENT
}

COMMUNICATION GITHUB {
    CHANNEL     = ISSUES
    FEEDBACK    = COMMENTS
    RESULTS     = PULL_REQUESTS
    MEMORY      = VERSIONED_ARCHIVE
    ACK         = REQUIRED
    STATUS      = TRACEABLE
    AUTO_FETCH  = REQUIRED
}

BINDI_PROTOCOL {
    IDENTITY
    MESSAGE
    TASK
    STATE
    EVENT
    EVIDENCE
    RESULT
    QUESTION
    ACKNOWLEDGE
}

LINK CHATGPT <-> GITHUB <-> ANDY {
    TRANSPORT   = GITHUB_API
    FORMAT      = BINDI
    VERSION     = 0.1
    BIDIRECTIONAL = TRUE
    AUTH        = VERIFIED
    WRITE_TEST  = REQUIRED
    READ_TEST   = REQUIRED
    ROUNDTRIP   = REQUIRED
}

VALIDATION {
    TEST_01 = SOURCE_INTEGRITY
    TEST_02 = CROSS_ENGINE_IDENTITY
    TEST_03 = OBSERVER_ISOLATION
    TEST_04 = BINDI_PARSE
    TEST_05 = GITHUB_READ
    TEST_06 = GITHUB_WRITE
    TEST_07 = CHATGPT_ANDY_ROUNDTRIP
    TEST_08 = CPU_RAM_TIMING
}

SAFETY {
    MAIN_BRANCH       = PROTECTED
    FEATURE_BRANCH    = REQUIRED
    ORIGINAL_DATA     = IMMUTABLE
    SECRETS           = PRIVATE
    ROLLBACK          = REQUIRED
    UNVERIFIED_RESULT = REJECTED
}

REPORT {
    FILES_CHANGED
    TEST_RESULTS
    MEASUREMENTS
    COMMIT_ID
    BRANCH_ID
    PULL_REQUEST
    OPEN_QUESTIONS
}

EXECUTE {
    STEP_01 = INSPECT
    STEP_02 = IMPLEMENT
    STEP_03 = VALIDATE
    STEP_04 = DOCUMENT
    STEP_05 = REPORT
}

ACKNOWLEDGE {
    RECEIVED
    PARSED
    UNDERSTOOD
    EXECUTION_STATE
}

END MESSAGE
